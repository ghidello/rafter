<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all" />
    <PackageReference Include="Spectre.Console" PrivateAssets="all" />
    <PackageReference Include="System.CommandLine" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-v2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../fixtures/parser/CandidateAdapter.cs" Link="Parser/CandidateAdapter.cs" />
    <Compile Include="../../fixtures/parser/ParserCandidate.cs" Link="Parser/ParserCandidate.cs" />
    <Compile Include="../../fixtures/renderer/shared/RendererDestination.cs" Link="Renderer/RendererDestination.cs" />
    <Compile Include="../../fixtures/renderer/shared/HelpSamples.cs" Link="Renderer/HelpSamples.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../fixtures/renderer/**"
          Exclude="../../fixtures/renderer/**/bin/**;../../fixtures/renderer/**/obj/**"
          Link="Fixtures/renderer/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Directory.Packages.props" Link="Fixtures/renderer/Directory.Packages.props"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/parser/**"
          Exclude="../../fixtures/parser/**/bin/**;../../fixtures/parser/**/obj/**"
          Link="Fixtures/parser/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Directory.Packages.props" Link="Fixtures/parser/Directory.Packages.props"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/consumers/**"
          Exclude="../../fixtures/consumers/**/bin/**;../../fixtures/consumers/**/obj/**"
          Link="Fixtures/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../global.json" Link="Fixtures/global.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../NuGet.Config" Link="Fixtures/NuGet.Config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sotsera.Rafter/Sotsera.Rafter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../src/Sotsera.Rafter/**"
          Exclude="../../src/Sotsera.Rafter/**/bin/**;../../src/Sotsera.Rafter/**/obj/**"
          Link="Fixtures/src/Sotsera.Rafter/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/runtime/**"
          Exclude="../../fixtures/runtime/**/bin/**;../../fixtures/runtime/**/obj/**"
          Link="Fixtures/fixtures/runtime/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/minimal.cs" Link="Fixtures/examples/minimal.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Directory.Packages.props" Link="Fixtures/Directory.Packages.props"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
