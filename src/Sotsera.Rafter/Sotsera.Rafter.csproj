<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <Version>0.1.0-local</Version>
    <Authors>Alessandro Ghidini</Authors>
    <Description>C# automation scripts with typed inputs, target dependencies, and owned process execution.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/sotsera/rafter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rafter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sotsera.Rafter.Analyzers/Sotsera.Rafter.Analyzers.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../Sotsera.Rafter.Analyzers/bin/$(Configuration)/netstandard2.0/Sotsera.Rafter.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
    <None Include="build/Sotsera.Rafter.targets" Pack="true" PackagePath="build/net10.0/" />
  </ItemGroup>
</Project>
